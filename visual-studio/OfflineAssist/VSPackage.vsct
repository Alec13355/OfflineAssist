<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidOfflineAssistPackage">
    <Groups>
      <Group guid="guidOfflineAssistCmdSet" id="OfflineAssistMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidOfflineAssistCmdSet" id="cmdidOpenChat" priority="0x0100" type="Button">
        <Parent guid="guidOfflineAssistCmdSet" id="OfflineAssistMenuGroup" />
        <Strings>
          <ButtonText>OfflineAssist: Open Chat</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOfflineAssistCmdSet" id="cmdidDownloadModel" priority="0x0101" type="Button">
        <Parent guid="guidOfflineAssistCmdSet" id="OfflineAssistMenuGroup" />
        <Strings>
          <ButtonText>OfflineAssist: Download Chat Model</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOfflineAssistCmdSet" id="cmdidRefreshModels" priority="0x0102" type="Button">
        <Parent guid="guidOfflineAssistCmdSet" id="OfflineAssistMenuGroup" />
        <Strings>
          <ButtonText>OfflineAssist: Refresh Model Catalog</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOfflineAssistCmdSet" id="cmdidAddHuggingFaceModel" priority="0x0103" type="Button">
        <Parent guid="guidOfflineAssistCmdSet" id="OfflineAssistMenuGroup" />
        <Strings>
          <ButtonText>OfflineAssist: Add Hugging Face Model</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOfflineAssistCmdSet" id="cmdidListHuggingFaceImports" priority="0x0104" type="Button">
        <Parent guid="guidOfflineAssistCmdSet" id="OfflineAssistMenuGroup" />
        <Strings>
          <ButtonText>OfflineAssist: List Hugging Face Imports</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOfflineAssistCmdSet" id="cmdidRemoveHuggingFaceImport" priority="0x0105" type="Button">
        <Parent guid="guidOfflineAssistCmdSet" id="OfflineAssistMenuGroup" />
        <Strings>
          <ButtonText>OfflineAssist: Remove Hugging Face Import</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOfflineAssistCmdSet" id="cmdidValidateHuggingFaceImports" priority="0x0106" type="Button">
        <Parent guid="guidOfflineAssistCmdSet" id="OfflineAssistMenuGroup" />
        <Strings>
          <ButtonText>OfflineAssist: Validate Hugging Face Imports</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidOfflineAssistCmdSet" id="cmdidPrepareHuggingFaceImport" priority="0x0107" type="Button">
        <Parent guid="guidOfflineAssistCmdSet" id="OfflineAssistMenuGroup" />
        <Strings>
          <ButtonText>OfflineAssist: Prepare Hugging Face Import</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidOfflineAssistPackage" value="{3D5E1B84-2A7F-4C8D-9E0F-1B2C3D4E5F60}" />

    <GuidSymbol name="guidOfflineAssistCmdSet" value="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}">
      <IDSymbol name="OfflineAssistMenuGroup"      value="0x1020" />
      <IDSymbol name="cmdidOpenChat"               value="0x0100" />
      <IDSymbol name="cmdidDownloadModel"          value="0x0101" />
      <IDSymbol name="cmdidRefreshModels"          value="0x0102" />
      <IDSymbol name="cmdidAddHuggingFaceModel"    value="0x0103" />
      <IDSymbol name="cmdidListHuggingFaceImports" value="0x0104" />
      <IDSymbol name="cmdidRemoveHuggingFaceImport"    value="0x0105" />
      <IDSymbol name="cmdidValidateHuggingFaceImports" value="0x0106" />
      <IDSymbol name="cmdidPrepareHuggingFaceImport"   value="0x0107" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
